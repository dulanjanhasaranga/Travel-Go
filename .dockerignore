# Send only the application build inputs to the container builder.
**
!Dockerfile
!Dockerfile.cloud-evaluation
!Dockerfile.cloud-evaluation-init
!.mvn/
!.mvn/wrapper/
!.mvn/wrapper/maven-wrapper.properties
!mvnw
!pom.xml
!src/
!src/main/
!src/main/**
!scripts/
!scripts/render-entrypoint.sh
!scripts/render-init-entrypoint.sh
**/node_modules/**
**/target/**
**/uploads/**
**/private-data/**
**/private-backups/**
**/checkpoints/**
**/github-release/**
**/local.properties
**/local-security.properties
**/.env*
**/*.log
**/*.pem
**/*.key
**/*.p12
**/*.jks
